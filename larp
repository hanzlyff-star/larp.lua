-- tinggi setengah kepala VISUAL (part size × skala mesh kalau ada)
-- ini kunci buat rig R6 mentah 1x1x1 + SpecialMesh 1.25 kayak Evade
local function visualHalfY(part)
    if not part then return 0.5 end
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if mesh and mesh.Scale then
        return (part.Size.Y * math.abs(mesh.Scale.Y)) / 2
    end
    return part.Size.Y / 2
end

local function waitForRig(char, timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 15) do
        if not LoopsRunning then return false end
        if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then
            if findHead(char) or findTorso(char) then
                return true
            end
        end
        task.wait(0.2)
    end
    return false
end

-- ============================================================
-- HEADLESS (nuclear: head + semua part yang nempel di head)
-- ============================================================
local HeadlessWatch = {}
local HeadlessHidden = {} -- [part] = LocalTransparencyModifier asli

local function hidePartDeep(part)
    if not part or not part:IsA("BasePart") then return end
    if HeadlessHidden[part] == nil then
        HeadlessHidden[part] = part.LocalTransparencyModifier
    end
    part.LocalTransparencyModifier = 1
    part.Transparency = 1
end

local function hideHeadNow(char)
    if not char then return end
    local head = findHead(char)
    if head then
        if not HeadlessWatch[head] then
            HeadlessWatch[head] = true
            track(head:GetPropertyChangedSignal("Transparency"):Connect(function()
                head.Transparency = 1
                head.LocalTransparencyModifier = 1
            end))
            track(head:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
                head.LocalTransparencyModifier = 1
            end))
        end
        hidePartDeep(head)
        for _, d in ipairs(head:GetChildren()) do
            if (d:IsA("Decal") or d:IsA("Texture")) and d.Name:lower():find("face") then
                if d:GetAttribute("HanzFaceT") == nil then
                    d:SetAttribute("HanzFaceT", d.Transparency)
                end
                d.Transparency = 1
            end
        end
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            if head:GetAttribute("HanzMeshS") == nil then
                head:SetAttribute("HanzMeshS", mesh.Scale)
            end
            mesh.Scale = Vector3.new(0, 0, 0)
        end
        -- SEMUA part yang di-weld ke head ikut di-hide:
        -- custom mesh head, rambut, topi bawaan game
