local function getChar()
    local c = LocalPlayer.Character
    if c and c.Parent and c:FindFirstChildOfClass("Humanoid") then
        return c
    end

    for _, folderName in ipairs({"Players", "PlayerCache", "Rigs"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder and folder:IsA("Folder") then
            local m = folder:FindFirstChild(LocalPlayer.Name)
            if m and m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
                return m
            end
        end
    end

    local cam = workspace.CurrentCamera
    if cam then
        local subj = cam.CameraSubject
        if subj then
            if subj:IsA("Humanoid") and subj.Parent and subj.Parent:IsA("Model") then
                return subj.Parent
            end
            if subj:IsA("BasePart") and subj.Parent then
                local m = subj.Parent
                while m and not m:IsA("Model") do
                    m = m.Parent
                end
                if m and m:FindFirstChildOfClass("Humanoid") then
                    return m
                end
            end
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == LocalPlayer.Name
            and obj:FindFirstChildOfClass("Humanoid") then
            return obj
        end
    end

    return nil
end

local function findHead(char)
    if not char then return nil end
    local h = char:FindFirstChild("Head")
    if h and h:IsA("BasePart") then return h end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("head") then
            return d
        end
    end
    return nil
end

local function findTorso(char)
    if not char then return nil end
    for _, n in ipairs({"UpperTorso", "Torso"}) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    local head = findHead(char)
    local best, bestSize = nil, 0
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d ~= head then
            local s = d.Size.X * d.Size.Y * d.Size.Z
            if s > bestSize then best, bestSize = d, s end
        end
    end
    return best
end

local function getRootPart(char)
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    return findTorso(char)
end

local function waitForRig(char, timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 15) do
        if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then
            if findHead(char) or findTorso(char) then
                return true
            end
        end
        task.wait(0.2)
    end
    return false
end

local function hideHead(char)
    local head = findHead(char)
    if not head then return end
    head.Transparency = 1
    head.LocalTransparencyModifier = 1
    local face = head:FindFirstChild("face")
    if face then face.Transparency = 1 end
    local mesh = head:FindFirstChildOfClass("SpecialMesh")
    if mesh then mesh.Scale = Vector3.new(0, 0, 0) end
end

local function showHead(char)
    local head = findHead(char)
    if not head then return end
    head.Transparency = 0
    head.LocalTransparencyModifier = 0
    local face = head:FindFirstChild("face")
    if face then face.Transparency = 0 end
end

