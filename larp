_G.HanzAccCleanup = function()
    LoopsRunning = false
    for _, c in ipairs(ActiveConnections) do
        pcall(function() c:Disconnect() end)
    end
    ActiveConnections = {}
    pcall(function()
        for _, m in ipairs(AccHolder:GetChildren()) do
            if m:GetAttribute("HanzAcc") then
                pcall(function() m:Destroy() end)
            end
        end
    end)
    pcall(function()
        for _, m in ipairs(workspace:GetChildren()) do
            if m.Name:sub(1, 9) == "HanzClone" then
                pcall(function() m:Destroy() end)
            end
        end
    end)
    pcall(function()
        if CloneState and CloneState.model then
            pcall(function() CloneState.model:Destroy() end)
        end
    end)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg and pg:FindFirstChild("HanzAccessoryGui") then
            pg.HanzAccessoryGui:Destroy()
        end
    end)
end

