local function loadPresetsFromDisk()
    local ok, err = pcall(function()
        if readfile and isfile and isfile(PRESET_FILE_NAME) then
            local decoded = HttpService:JSONDecode(readfile(PRESET_FILE_NAME))
            if decoded and type(decoded) == "table" then State.presets = decoded end
        end
        if readfile and isfile and isfile("AccessoryPresets.json") then
            local decoded2 = HttpService:JSONDecode(readfile("AccessoryPresets.json"))
            if decoded2 and type(decoded2) == "table" then
                for k, v in pairs(decoded2) do
                    if State.presets[k] == nil then State.presets[k] = v end
                end
            end
        end
    end)
    if not ok then
        print("[Hanz] Gagal baca preset:", err)
    end
    refreshPresetListUI()
end

