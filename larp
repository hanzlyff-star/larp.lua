local function updateStatusUI()
    if #activeAccessories == 0 then
        selectedIndex = 0
        AccStatusLabel.Text = "Aktif: [ Kosong ]"
    else
        if selectedIndex < 1 then selectedIndex = 1 end
        if selectedIndex > #activeAccessories then selectedIndex = #activeAccessories end
        local current = activeAccessories[selectedIndex]
        AccStatusLabel.Text = "No." .. selectedIndex .. " | ID: " .. current.id
    end
end

local function setHeadless(state)
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local face = head:FindFirstChild("face")
    local mesh = head:FindFirstChildOfClass("SpecialMesh")
    if state then
        head.Transparency = 1
        if face then face.Transparency = 1 end
        if mesh then mesh.Scale = Vector3.new(0, 0, 0) end
    else
        head.Transparency = 0
        if face then face.Transparency = 0 end
        if mesh then mesh.Scale = Vector3.new(1.25, 1.25, 1.25) end
    end
end

local function applyScaleToPart(part, scaleTable)
    if not part or not scaleTable then return end
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        mesh.Scale = Vector3.new(table.unpack(scaleTable))
    elseif part:IsA("MeshPart") then
        part.Size = Vector3.new(table.unpack(scaleTable))
    end
end

local function findUniversalTargetPart(char, accessoryItem)
    local handle = accessoryItem:FindFirstChild("Handle") or accessoryItem
    local att = handle:FindFirstChildOfClass("Attachment")
    if att then
        local attName = att.Name
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                for _, child in pairs(part:GetChildren()) do
                    if child:IsA("Attachment") and child.Name == attName then
                        return part
                    end
                end
            end
        end
    end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function spawnAccessoryWithData(assetId, savedC0Matrix, scaleTable)
    local char = LocalPlayer.Character
    if not char then return end

    pcall(function()
        local assetModel = nil
        local success, err = pcall(function()
            assetModel = InsertService:LoadAsset(assetId)
        end)
        if not success or not assetModel then
            assetModel = game:GetObjects("rbxassetid://" .. tostring(assetId))[1]
        end

        if assetModel then
            for _, item in pairs(assetModel:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Hat") then
                    item.Parent = char
                    local handle = item:FindFirstChild("Handle")
                    if handle then
                        local targetPart = findUniversalTargetPart(char, item)
                        local weld = handle:FindFirstChildOfClass("Weld") or handle:FindFirstChildOfClass("WeldConstraint")
                        if not weld or not weld:IsA("Weld") then
                            if weld then weld:Destroy() end
                            weld = Instance.new("Weld")
                            weld.Part0 = targetPart
                            weld.Part1 = handle
                            weld.Parent = handle
                        end
                        
                        if savedC0Matrix then
                            weld.C0 = CFrame.new(table.unpack(savedC0Matrix))
                        else
                            weld.C0 = CFrame.new(0, 0, 0)
                        end
                        
                        if scaleTable then
                            applyScaleToPart(handle, scaleTable)
                        end
                        
                        table.insert(activeAccessories, {
                            id = tostring(assetId), 
                            model = item, 
                            part = handle, 
                            weld = weld
                        })
                    end
                elseif item:IsA("BasePart") or item:IsA("MeshPart") then
                    item.CanCollide = false
                    item.Parent = char
                    local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    local weld = Instance.new("Weld")
                    weld.Part0 = targetPart
                    weld.Part1 = item
                    
                    if savedC0Matrix then
                        weld.C0 = CFrame.new(table.unpack(savedC0Matrix))
                    else
                        weld.C0 = CFrame.new(0, 0.5, 0)
                    end
                    weld.Parent = item
                    
                    if scaleTable then
                        applyScaleToPart(item, scaleTable)
                    end
                    
                    table.insert(activeAccessories, {
                        id = tostring(assetId), 
                        model = item, 
                        part = item, 
                        weld = weld
                    })
                elseif item:IsA("Model") then
                    for _, child in pairs(item:GetChildren()) do
                        if child:IsA("Accessory") or child:IsA("Hat") then
                            child.Parent = char
                            local handle = child:FindFirstChild("Handle")
                            local targetPart = findUniversalTargetPart(char, child)
                            local weld = handle and (handle:FindFirstChildOfClass("Weld") or handle:FindFirstChildOfClass("WeldConstraint"))
                            if handle and (not weld or not weld:IsA("Weld")) then
                                if weld then weld:Destroy() end
                                weld = Instance.new("Weld")
                                weld.Part0 = targetPart
                                weld.Part1 = handle
                                weld.Parent = handle
                            end
                            
                            if savedC0Matrix and weld then
                                weld.C0 = CFrame.new(table.unpack(savedC0Matrix))
                            else
                                if weld then weld.C0 = CFrame.new(0, 0, 0) end
                            end
                            
                            if scaleTable and handle then
                                applyScaleToPart(handle, scaleTable)
                            end
                            
                            table.insert(activeAccessories, {
                                id = tostring(assetId), 
                                model = child, 
                                part = handle,
                                weld = weld
                            })
                        end
                    end
                end
            end
        end
    end)
    selectedIndex = #activeAccessories
    updateStatusUI()
end

