local function applyC0Offset(dx, dy, dz)
    local acc = getSelected()
    if not acc then return end
    if acc.topMount then
        acc.userDelta = acc.userDelta * CFrame.new(dx, dy, dz)
        if acc.targetPart and acc.targetPart.Parent and acc.handleAtt then
            acc.offsetCF = topHeadOffset(acc.targetPart, acc.handleAtt) * acc.userDelta
        end
    elseif acc.offsetCF then
        acc.offsetCF = acc.offsetCF * CFrame.new(dx, dy, dz)
    end
    rebuildPersist()
end

local function applyRotation(rx, ry, rz)
    local acc = getSelected()
    if not acc then return end
    if acc.topMount then
        acc.userDelta = acc.userDelta * CFrame.Angles(rx, ry, rz)
        if acc.targetPart and acc.targetPart.Parent and acc.handleAtt then
            acc.offsetCF = topHeadOffset(acc.targetPart, acc.handleAtt) * acc.userDelta
        end
    elseif acc.offsetCF then
        acc.offsetCF = acc.offsetCF * CFrame.Angles(rx, ry, rz)
    end
    rebuildPersist()
end

