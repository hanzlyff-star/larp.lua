-- LOOP UTAMA: aksesoris ngikut + headless
-- topMount = posisi dihitung ulang tiap frame → kebal respawn/resize/ganti rig
track(RunService.RenderStepped:Connect(function(dt)
    if not LoopsRunning then return end
    local char = getCharFast()
    if State.headless then
        hideHeadNow(char)
    end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local alive = char ~= nil and hum ~= nil and hum.Health > 0
        and hum:GetState() ~= Enum.HumanoidStateType.Dead
    for _, acc in ipairs(State.active) do
        local part = acc.part
        if part and part.Parent then
            if not alive then
                part.Transparency = 1
            else
                if part.Transparency ~= acc.baseTransparency then
                    part.Transparency = acc.baseTransparency
                end
                local tp = acc.targetPart
                -- self-heal: part target diganti game → cari lagi
                if (not tp or not tp.Parent) and char then
                    if acc.forceTarget then
                        tp = findPartByRole(char, acc.forceTarget)
                    end
                    if not tp and acc.targetName then
                        if acc.targetName:lower():find("head") then
                            tp = findHead(char)
                        else
                            tp = findTorso(char)
                        end
                    end
                    if not tp then
                        tp = findHead(char) or findTorso(char)
                    end
                    if tp then
                        acc.targetPart = tp
                        acc.targetName = tp.Name
                    end
                end
                if tp and tp.Parent then
                    if acc.topMount and acc.handleAtt then
                        part.CFrame = tp.CFrame * topHeadOffset(tp, acc.handleAtt) * acc.userDelta
                        acc.offsetCF = tp.CFrame:Inverse() * part.CFrame
                    elseif acc.offsetCF then
                        part.CFrame = tp.CFrame * acc.offsetCF
                    end
                end
            end
        end
    end

    if CloneState.accFollow then
        for _, a in ipairs(CloneState.accFollow) do
            if a.handle.Parent and a.part.Parent then
                a.handle.CFrame = a.part.CFrame * a.relCF
            end
        end
    end
end))

