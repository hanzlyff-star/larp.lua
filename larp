local function getChar()
    local c = LocalPlayer.Character
    if c and c.Parent and c:FindFirstChildOfClass("Humanoid") then
        return c
    end
    for _, folderName in ipairs({"Players", "PlayerCache", "Rigs"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder and folder:IsA("Folder") then
            local m = folder:FindFirstChild(LocalPlayer.Name)
            if m and m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
                return m
            end
        end
    end
    local cam = workspace.CurrentCamera
    if cam then
        local subj = cam.CameraSubject
        if subj then
            if subj:IsA("Humanoid") and subj.Parent and subj.Parent:IsA("Model") then
                return subj.Parent
            end
            if subj:IsA("BasePart") and subj.Parent then
                local m = subj.Parent
                while m and not m:IsA("Model") do
                    m = m.Parent
                end
                if m and m:FindFirstChildOfClass("Humanoid") then
                    return m
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == LocalPlayer.Name
            and obj:FindFirstChildOfClass("Humanoid") then
            return obj
        end
    end
    return nil
end

