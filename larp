local function cleanComponents(t)
    if type(t) ~= "table" then return nil end
    local out = {}
    for i = 1, 12 do
        local v = tonumber(t[i]) or 0
        if v ~= v or v == math.huge or v == -math.huge then
            v = 0
        end
        if math.abs(v) > 1e6 then
            v = 0
        end
        out[i] = v
    end
    return out
end

-- offset mount di atas kepala VISUAL, dihitung dari part asli
-- (bukan angka tebakan) — aman di rig apapun termasuk R6 mentah + mesh
local function topHeadOffset(targetPart, handleAtt)
    local halfY = visualHalfY(targetPart)
    local lift = math.max(targetPart.Size.Y * 0.04, 0.03)
    return CFrame.new(0, halfY + lift, 0) * handleAtt.CFrame:Inverse()
end

local function computeOffset(targetPart, char, data)
    if not targetPart or not char then return nil end
    if data.topMount and data._handle then
        local handleAtt = data._handle:FindFirstChildOfClass("Attachment")
        local ud = CFrame.new(0, 0, 0)
        if data.userDelta then
            local udc = cleanComponents(data.userDelta)
            if udc then ud = CFrame.new(table.unpack(udc)) end
        end
        if handleAtt then
            return topHeadOffset(targetPart, handleAtt) * ud
        end
        return ud
    end
    local c1 = nil
    if data.c1 then
        local c1c = cleanComponents(data.c1)
        if c1c then c1 = CFrame.new(table.unpack(c1c)) end
    end
    if not c1 then c1 = CFrame.new(0, 0, 0) end
    local desiredWorld
    if data.rootRel then
        local rc = cleanComponents(data.rootRel)
        local root = getRootPart(char)
        if not rc or not root then return nil end
        desiredWorld = root.CFrame * CFrame.new(table.unpack(rc))
    elseif data.c0 then
        local c0c = cleanComponents(data.c0)
        if not c0c then return nil end
        desiredWorld = targetPart.CFrame * CFrame.new(table.unpack(c0c)) * c1:Inverse()
    else
        local handle = data._handle
        local handleAtt = handle and handle:FindFirstChildOfClass("Attachment") or nil
        if not handleAtt then
            -- item jadul tanpa attachment: weld klasik di origin part
            return CFrame.new(0, 0, 0)
        end
        local targetAtt = targetPart:FindFirstChild(handleAtt.Name)
        if not targetAtt then
            for _, d in ipairs(targetPart:GetDescendants()) do
                if d:IsA("Attachment") and d.Name == handleAtt.Name then
                    targetAtt = d
                    break
                end
            end
        end
        if targetAtt then
            -- rig game punya attachment asli → percaya (lobby game lewat sini)
            return targetAtt.CFrame * handleAtt.CFrame:Inverse()
        end
        -- rig game NGGAK punya attachment → mount di atas kepala visual
        local role = ATTACH_TO_PART[handleAtt.Name] or heuristicRole(handleAtt.Name) or partRoleOf(targetPart)
        if role == "Head" then
            return topHeadOffset(targetPart, handleAtt)
        end
        return CFrame.new(0, 0, 0)
    end
    return targetPart.CFrame:Inverse() * desiredWorld * c1:Inverse()
end

local function findTargetPart(char, item, handle, forceTarget)
    if forceTarget then
        local p = findPartByRole(char, forceTarget)
        if p then return p, p.Name end
    end

    local handleAtt = handle and handle:FindFirstChildOfClass("Attachment") or nil
    if handleAtt then
        local charAtt = char:FindFirstChild(handleAtt.Name, true)
        if charAtt and charAtt:IsA("Attachment") and charAtt.Parent and charAtt.Parent:IsA("BasePart") then
            return charAtt.Parent, charAtt.Parent.Name
        end
        local role = ATTACH_TO_PART[handleAtt.Name] or heuristicRole(handleAtt.Name)
        if role then
            local p = findPartByRole(char, role)
            if p then return p, p.Name end
        end
    end

    if item:IsA("Accessory") then
        local ok, accType = pcall(function() return item.AccessoryType end)
        if ok and accType then
            if accType == Enum.AccessoryType.Hat
                or accType == Enum.AccessoryType.Hair
                or accType == Enum.AccessoryType.Face
                or accType == Enum.AccessoryType.Neck
                or accType == Enum.AccessoryType.Head then
                local head = findHead(char)
                if head then return head, head.Name end
            elseif accType == Enum.AccessoryType.Waist then
                local p = findPartByRole(char, "LowerTorso")
                if p then return p, p.Name end
            else
                local torso = findTorso(char)
                if torso then return torso, torso.Name end
            end
        end
    end

    local head = findHead(char)
    if head then return head, head.Name end
    local torso = findTorso(char)
    if torso then return torso, torso.Name end
    return nil, "Unknown"
end

local function snapshotAccessory(acc)
    if acc.topMount then
        return {
            id = acc.id,
            targetName = acc.targetName,
            topMount = true,
            userDelta = {acc.userDelta:GetComponents()},
            scale = acc.scaleComp,
            forceTarget = acc.forceTarget,
        }
    end
    return {
        id = acc.id,
        targetName = acc.targetName,
        c0 = acc.offsetCF and {acc.offsetCF:GetComponents()} or nil,
        c1 = acc.c1Comp,
        rootRel = acc.rootRelComp,
        scale = acc.scaleComp,
        forceTarget = acc.forceTarget,
    }
end

local function rebuildPersist()
