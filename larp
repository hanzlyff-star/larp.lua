local function refreshPresetListUI()
    for _, c in ipairs(PresetScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local count = 0
    for name, data in pairs(State.presets) do
        count = count + 1
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, -6, 0, 22)
        f.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
        f.BorderSizePixel = 0
        f.Parent = PresetScroll
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 4)

        local loadBtn = Instance.new("TextButton")
        loadBtn.Size = UDim2.new(0.68, 0, 1, 0)
        loadBtn.BackgroundTransparency = 1
        loadBtn.Text = "  " .. name
        loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        loadBtn.TextSize = 9
        loadBtn.Font = Enum.Font.GothamMedium
        loadBtn.TextXAlignment = Enum.TextXAlignment.Left
        loadBtn.Parent = f
        loadBtn.MouseButton1Click:Connect(function()
            for _, acc in ipairs(State.active) do
                pcall(function() if acc.model then acc.model:Destroy() end end)
            end
            State.active = {}
            State.persist = {}
            for _, accInfo in ipairs(data) do
                spawnAccessory(accInfo)
                task.wait(0.15)
            end
            rebuildPersist()
            updateStatusUI()
        end)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0.28, 0, 0.8, 0)
        delBtn.Position = UDim2.new(0.70, 0, 0.1, 0)
        delBtn.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
        delBtn.BorderSizePixel = 0
        delBtn.Text = "HAPUS"
        delBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        delBtn.TextSize = 8
        delBtn.Font = Enum.Font.GothamBold
        delBtn.Parent = f
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 3)
        delBtn.MouseButton1Click:Connect(function()
            State.presets[name] = nil
            savePresetsToDisk()
            refreshPresetListUI()
        end)
    end
    PresetScroll.CanvasSize = UDim2.new(0, 0, 0, count * 24)
end

local function loadPresetsFromDisk()
    pcall(function()
        if readfile and isfile and isfile(PRESET_FILE_NAME) then
            local decoded = HttpService:JSONDecode(readfile(PRESET_FILE_NAME))
            if decoded and type(decoded) == "table" then State.presets = decoded end
        end
    end)
    refreshPresetListUI()
end

