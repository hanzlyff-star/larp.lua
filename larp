local function applyC0Offset(dx, dy, dz)
    if selectedIndex > 0 and activeAccessories[selectedIndex] then
        local entry = activeAccessories[selectedIndex]
        if entry.weld and entry.weld:IsA("Weld") then
            entry.weld.C0 = entry.weld.C0 * CFrame.new(dx, dy, dz)
        end
    end
end

local function applyRotation(rx, ry, rz)
    if selectedIndex > 0 and activeAccessories[selectedIndex] then
        local entry = activeAccessories[selectedIndex]
        if entry.weld and entry.weld:IsA("Weld") then
            entry.weld.C0 = entry.weld.C0 * CFrame.Angles(rx, ry, rz)
        end
    end
end

