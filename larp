    for _, acc in ipairs(State.active) do
        if acc.part and acc.part.Parent then
            table.insert(newPersist, snapshotAccessory(acc))
        end
    end
    State.persist = newPersist
end

local function applyScale(part, scaleTable)
    if not part or not scaleTable then return end
    local s = {}
    for i = 1, 3 do
        local v = tonumber(scaleTable[i]) or 1
        if v ~= v or math.abs(v) > 1e5 then v = 1 end
        s[i] = v
    end
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        mesh.Scale = Vector3.new(s[1], s[2], s[3])
    elseif part:IsA("MeshPart") then
        part.Size = Vector3.new(s[1], s[2], s[3])
    end
end

local function prepPart(part)
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Massless = true
    part.Anchored = true
end

local function registerAccessory(item, part, targetPart, targetName, char, data)
    data._handle = part
    local offset = computeOffset(targetPart, char, data)
    local acc = {
        id = tostring(data.id),
        model = item,
        part = part,
        targetPart = targetPart,
        targetName = targetName,
        offsetCF = offset,
        c1Comp = data.c1 and cleanComponents(data.c1) or nil,
        rootRelComp = data.rootRel and cleanComponents(data.rootRel) or nil,
        scaleComp = data.scale and {tonumber(data.scale[1]) or 1, tonumber(data.scale[2]) or 1, tonumber(data.scale[3]) or 1} or nil,
        baseTransparency = part.Transparency,
        forceTarget = data.forceTarget,
        topMount = data.topMount and true or false,
        userDelta = CFrame.new(0, 0, 0),
        handleAtt = part:FindFirstChildOfClass("Attachment"),
    }
    if data.userDelta then
        local udc = cleanComponents(data.userDelta)
        if udc then acc.userDelta = CFrame.new(table.unpack(udc)) end
    end
    table.insert(State.active, acc)
    if offset then
        part.CFrame = targetPart.CFrame * offset
    end
    if not offset and (data.rootRel or data.c0) then
        task.delay(0.5, function()
            if not LoopsRunning then return end
            if not acc.part or not acc.part.Parent then return end
            local tp = acc.targetPart and acc.targetPart.Parent and acc.targetPart or findTorso(char) or findHead(char)
            if not tp then return end
            acc.targetPart = tp
            acc.offsetCF = computeOffset(tp, char, data)
            if acc.offsetCF then
                acc.part.CFrame = tp.CFrame * acc.offsetCF
            end
        end)
    end
end

local function processItem(item, char, data)
    if not LoopsRunning then return end
    if item:IsA("Accessory") or item:IsA("Hat") then
        local handle = item:FindFirstChild("Handle")
        if not handle then return end
        local targetPart, targetName = findTargetPart(char, item, handle, data.forceTarget)
        if not targetPart then
            targetPart = findTorso(char)
            targetName = targetPart and targetPart.Name or "Torso"
        end
        if not targetPart then return end
        -- kalau rig game nggak punya attachment pasangan & targetnya kepala
        -- → pakai mode topMount (posisi dihitung ulang tiap frame)
        if not data.topMount and not data.c0 and not data.rootRel then
            local handleAtt = handle:FindFirstChildOfClass("Attachment")
            if handleAtt then
                local hasMatch = char:FindFirstChild(handleAtt.Name, true) ~= nil
                local role = ATTACH_TO_PART[handleAtt.Name] or heuristicRole(handleAtt.Name)
                if not hasMatch and (role == "Head" or (role == nil and targetName:lower():find("head"))) then
                    data.topMount = true
                end
            end
        end
        prepPart(handle)
        item:SetAttribute("HanzAcc", true)
        item.Parent = AccHolder
        registerAccessory(item, handle, targetPart, targetName, char, data)
        if data.scale then applyScale(handle, data.scale) end
    elseif item:IsA("BasePart") or item:IsA("MeshPart") then
        prepPart(item)
        item:SetAttribute("HanzAcc", true)
        item.Parent = AccHolder
        local targetPart = findTorso(char) or findHead(char)
        if not targetPart then return end
        registerAccessory(item, item, targetPart, targetPart.Name, char, data)
        if data.scale then applyScale(item, data.scale) end
    elseif item:IsA("Model") or item:IsA("Folder") then
        for _, child in ipairs(item:GetChildren()) do
            processItem(child, char, data)
        end
    end
end

local function spawnAccessory(data, char)
    char = char or getChar()
    if not char then
        updateStatus("Gagal: karakter nggak ketemu")
        return false
    end
    local numId = tonumber(data.id)
    if not numId then return false end
    local objects
    local ok = pcall(function()
        objects = game:GetObjects("rbxassetid://" .. tostring(numId))
    end)
    if (not ok or not objects or #objects == 0) then
        pcall(function()
            local m = InsertService:LoadAsset(numId)
            if m then objects = {m} end
        end)
    end
    if not objects or #objects == 0 then
        updateStatus("Gagal load ID: " .. tostring(numId))
        return false
    end
    local before = #State.active
    for _, obj in ipairs(objects) do
        processItem(obj, char, data)
    end
    return #State.active > before
end

