local function removeClone()
    CloneState.accFollow = nil
    CloneState.animator = nil
    if CloneState.model then
        pcall(function() CloneState.model:Destroy() end)
        CloneState.model = nil
    end
    for _, m in ipairs(workspace:GetChildren()) do
        if m.Name:sub(1, 9) == "HanzClone" then
            pcall(function() m:Destroy() end)
        end
    end
end

local function getCloneAnimator(createIfMissing)
    local model = CloneState.model
    if not model then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator and createIfMissing then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    CloneState.animator = animator
    return animator
end

local function applyTracksToClone(playing)
    local animator = getCloneAnimator(true)
    if not animator then return false end
    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
        pcall(function() t:Stop(0) end)
    end
    for _, p in ipairs(playing) do
        pcall(function()
            local a = Instance.new("Animation")
            a.AnimationId = p.id
            local track = animator:LoadAnimation(a)
            track.Looped = p.looped
            track:Play(0)
            track.TimePosition = p.time
            track.Speed = p.speed
        end)
    end
    return true
end

local function capturePlayingTracks()
    local found = {}
    local char = getChar()
    local hum0 = char and char:FindFirstChildOfClass("Humanoid")
    local anim0 = hum0 and hum0:FindFirstChildOfClass("Animator")
    if not anim0 then return found end
    for _, t in ipairs(anim0:GetPlayingAnimationTracks()) do
        if t.Animation and t.IsPlaying then
            table.insert(found, {
                id = t.Animation.AnimationId,
                time = t.TimePosition,
                speed = t.Speed,
                looped = t.Looped,
            })
        end
    end
    return found
end

local function snapshotClone()
    removeClone()
    updateStatus("Clone: cari karakter...")
    local char = getChar()
    if not char then
        updateStatus("Clone gagal: karakter nggak ketemu")
        return
    end

    local playing = capturePlayingTracks()

    local nameText = CloneNameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if nameText == "" then
        nameText = LocalPlayer.DisplayName
    end

    char.Archivable = true
    local ok, model = pcall(function() return char:Clone() end)
    if not ok or not model then
        updateStatus("Clone gagal: gagal duplikasi karakter")
        return
    end

    model.Name = "HanzClone_" .. nameText
    model:SetAttribute("HanzAcc", true)
    model.Parent = workspace

    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") or d:IsA("Animator") then
            pcall(function() d:Destroy() end)
        elseif d:IsA("BasePart") then
            d.CanCollide = false
            d.CanQuery = false
            d.CanTouch = false
        end
    end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
        hum.NameDisplayDistance = 1000
        hum.HealthDisplayDistance = 0
        hum.DisplayName = nameText
    end

    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.Anchored = true end

    applyTracksToClone(playing)

    CloneState.accFollow = {}
    local accCloned = 0
    for _, acc in ipairs(State.active) do
        if acc.part and acc.part.Parent and acc.offsetCF then
            local okC, accModel2 = pcall(function() return acc.model:Clone() end)
            if okC and accModel2 then
                local handle2
                if accModel2:IsA("Accessory") or accModel2:IsA("Hat") then
                    handle2 = accModel2:FindFirstChild("Handle")
                elseif accModel2:IsA("BasePart") or accModel2:IsA("MeshPart") then
                    handle2 = accModel2
                else
                    for _, d in ipairs(accModel2:GetDescendants()) do
                        if d:IsA("BasePart") or d:IsA("MeshPart") then
                            handle2 = d
                            break
                        end
                    end
                end

                if handle2 then
                    local clonePart = model:FindFirstChild(acc.targetName or "", true)
                    if not (clonePart and clonePart:IsA("BasePart")) then
                        if acc.targetName and acc.targetName:lower():find("head") then
                            clonePart = findHead(model)
                        else
                            clonePart = findTorso(model)
                        end
                    end

                    if clonePart then
                        handle2.Anchored = true
                        handle2.CanCollide = false
                        handle2.CanQuery = false
                        handle2.CanTouch = false
                        handle2.Massless = true
                        if acc.scaleComp then
                            pcall(function() applyScale(handle2, acc.scaleComp) end)
                        end
                        accModel2:SetAttribute("HanzAcc", true)
                        accModel2.Parent = model
                        table.insert(CloneState.accFollow, {
                            handle = handle2,
                            part = clonePart,
                            relCF = acc.offsetCF,
                        })
                        accCloned = accCloned + 1
                    end
                end
            end
        end
    end

    CloneState.model = model
    updateStatus(string.format("Clone: %d anim | %d aksesoris | nama: %s",
        #playing, accCloned, nameText))
end

