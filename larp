local function findHead(char)
    if not char then return nil end
    local h = char:FindFirstChild("Head")
    if h and h:IsA("BasePart") then return h end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("head") then
            return d
        end
    end
    return nil
end

local function findTorso(char)
    if not char then return nil end
    for _, n in ipairs({"UpperTorso", "Torso"}) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    local head = findHead(char)
    local best, bestSize = nil, 0
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d ~= head then
            local s = d.Size.X * d.Size.Y * d.Size.Z
            if s > bestSize then best, bestSize = d, s end
        end
    end
    return best
end

local function getRootPart(char)
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    return findTorso(char)
end

local function findPartByRole(char, role)
    if role == "Head" then
        return findHead(char)
    elseif role == "UpperTorso" then
        local p = char:FindFirstChild("UpperTorso")
        if p and p:IsA("BasePart") then return p end
        local t = char:FindFirstChild("Torso")
        if t and t:IsA("BasePart") then return t end
        return nil
    elseif role == "LowerTorso" then
        local p = char:FindFirstChild("LowerTorso")
        if p and p:IsA("BasePart") then return p end
        local t = char:FindFirstChild("Torso")
        if t and t:IsA("BasePart") then return t end
        return nil
    elseif role == "HumanoidRootPart" then
        return getRootPart(char)
    end
    return nil
end

local function partRoleOf(part)
    if not part then return nil end
    local n = part.Name:lower()
    if n:find("head") then return "Head" end
    if n:find("upper") or n == "torso" then return "UpperTorso" end
    if n:find("lower") then return "LowerTorso" end
    if n:find("root") then return "HumanoidRootPart" end
    return nil
end

local function heuristicRole(attName)
    local n = attName:lower()
    if n:find("hat") or n:find("hair") or n:find("face") or n:find("head") then return "Head" end
    if n:find("neck") or n:find("shoulder") or n:find("collar")
        or n:find("bodyfront") or n:find("bodyback") then return "UpperTorso" end
    if n:find("waist") then return "LowerTorso" end
    return nil
end

