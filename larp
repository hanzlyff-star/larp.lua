local function updateStatusUI()
    if #State.active == 0 then
        State.selected = 0
        updateStatus("Aktif: [ Kosong ]")
    else
        if State.selected < 1 then State.selected = 1 end
        if State.selected > #State.active then State.selected = #State.active end
        local c = State.active[State.selected]
        updateStatus(string.format("No.%d | ID: %s | %s", State.selected, tostring(c.id), c.targetName or "?"))
    end
end

-- ============================================================
-- SNAPSHOT: posisi disimpan relatif ke HumanoidRootPart,
-- jadi nggak peduli nanti nempel ke part apa / rig apa.
-- ============================================================
local function snapshotAccessory(acc)
    local snap = {
        id = acc.id,
        targetName = acc.targetName,
        c0 = nil,
        c1 = nil,
        rootRel = nil,
        scale = nil,
    }
    if acc.weld and acc.weld:IsA("Weld")
        and acc.weld.Part0 and acc.weld.Part0.Parent
        and acc.weld.Part1 and acc.weld.Part1.Parent then
        snap.c0 = {acc.weld.C0:GetComponents()}
        snap.c1 = {acc.weld.C1:GetComponents()}
        local root = getRootPart(acc.weld.Part0.Parent)
        if root then
            local worldCF = acc.weld.Part0.CFrame * acc.weld.C0 * acc.weld.C1:Inverse()
            snap.rootRel = {(root.CFrame:Inverse() * worldCF):GetComponents()}
        end
    end
    if acc.part and acc.part.Parent then
        local mesh = acc.part:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            snap.scale = {mesh.Scale.X, mesh.Scale.Y, mesh.Scale.Z}
        elseif acc.part:IsA("MeshPart") then
            snap.scale = {acc.part.Size.X, acc.part.Size.Y, acc.part.Size.Z}
        end
    end
    return snap
end

local function rebuildPersist()
    State.persist = {}
    for _, acc in ipairs(State.active) do
        if acc.part and acc.part.Parent then
            table.insert(State.persist, snapshotAccessory(acc))
        end
    end
end

local function setupWeld(handle, targetPart, savedC0, savedC1)
    for _, v in ipairs(handle:GetChildren()) do
        if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("Motor6D") then
            v:Destroy()
        end
    end

    local weld = Instance.new("Weld")
    weld.Name = "HanzWeld"
    weld.Part0 = targetPart
    weld.Part1 = handle
    weld.Parent = handle

    if savedC0 and savedC1 then
        weld.C0 = CFrame.new(table.unpack(savedC0))
        weld.C1 = CFrame.new(table.unpack(savedC1))
        return weld
    end

    local handleAtt = handle:FindFirstChildOfClass("Attachment")
    if handleAtt then
        local targetAtt = targetPart:FindFirstChild(handleAtt.Name)
        if not targetAtt then
            for _, d in ipairs(targetPart:GetDescendants()) do
                if d:IsA("Attachment") and d.Name == handleAtt.Name then
                    targetAtt = d
                    break
                end
            end
        end
        if targetAtt and targetAtt:IsA("Attachment") then
            weld.C0 = targetAtt.CFrame
            weld.C1 = handleAtt.CFrame
            return weld
        end
        weld.C0 = handleAtt.CFrame
        weld.C1 = CFrame.new(0, 0, 0)
        return weld
    end

    weld.C0 = CFrame.new(0, 0.5, 0)
    weld.C1 = CFrame.new(0, 0, 0)
    return weld
end

local function applySavedPosition(weld, char, data)
    if not data.rootRel then return end
    local root = getRootPart(char)
    if not root then return end
    local c1 = (data.c1 and CFrame.new(table.unpack(data.c1))) or CFrame.new(0, 0, 0)
    local worldCF = root.CFrame * CFrame.new(table.unpack(data.rootRel))
    weld.C0 = weld.Part0.CFrame:Inverse() * worldCF * c1
    weld.C1 = c1
end

local function applyScale(part, scaleTable)
    if not part or not scaleTable then return end
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        mesh.Scale = Vector3.new(table.unpack(scaleTable))
    elseif part:IsA("MeshPart") then
        part.Size = Vector3.new(table.unpack(scaleTable))
    end
end

local function findTargetPart(char, item, handle)
    if handle then
        local handleAtt = handle:FindFirstChildOfClass("Attachment")
        if handleAtt then
            local charAtt = char:FindFirstChild(handleAtt.Name, true)
            if charAtt and charAtt:IsA("Attachment") and charAtt.Parent and charAtt.Parent:IsA("BasePart") then
                return charAtt.Parent, charAtt.Parent.Name
            end
        end
    end

    if item:IsA("Accessory") then
        local ok, accType = pcall(function() return item.AccessoryType end)
        if ok and accType then
            if accType == Enum.AccessoryType.Hat
                or accType == Enum.AccessoryType.Hair
                or accType == Enum.AccessoryType.Face
                or accType == Enum.AccessoryType.Neck
                or accType == Enum.AccessoryType.Head then
                local head = findHead(char)
                if head then return head, head.Name end
            else
                local torso = findTorso(char)
                if torso then return torso, torso.Name end
            end
        end
    end

    local torso = findTorso(char)
    if torso then return torso, torso.Name end
    return nil, "Unknown"
end

local function processItem(item, char, data)
    if item:IsA("Accessory") or item:IsA("Hat") then
        item.Parent = char
        local handle = item:FindFirstChild("Handle")
        if not handle then return end
        local targetPart, targetName = findTargetPart(char, item, handle)
        if not targetPart then
            targetPart = findTorso(char)
            targetName = targetPart and targetPart.Name or "Torso"
        end
        if not targetPart then return end
        local weld = setupWeld(handle, targetPart, data.c0, data.c1)
        applySavedPosition(weld, char, data)
        if data.scale then applyScale(handle, data.scale) end
        table.insert(State.active, {
            id = tostring(data.id), model = item, part = handle,
            weld = weld, targetName = targetName,
        })

    elseif item:IsA("BasePart") or item:IsA("MeshPart") then
        item.CanCollide = false
        item.Parent = char
        local targetPart = findTorso(char) or findHead(char)
        if not targetPart then return end
        local weld = setupWeld(item, targetPart, data.c0, data.c1)
        applySavedPosition(weld, char, data)
        if data.scale then applyScale(item, data.scale) end
        table.insert(State.active, {
            id = tostring(data.id), model = item, part = item,
            weld = weld, targetName = targetPart.Name,
        })

    elseif item:IsA("Model") or item:IsA("Folder") then
        for _, child in ipairs(item:GetChildren()) do
            processItem(child, char, data)
        end
    end
end

local function spawnAccessory(data, char)
    char = char or getChar()
    if not char then
        updateStatus("Gagal: karakter nggak ketemu")
        return false
    end

    local numId = tonumber(data.id)
    if not numId then return false end

    local objects
    local ok = pcall(function()
        objects = game:GetObjects("rbxassetid://" .. tostring(numId))
    end)
    if (not ok or not objects or #objects == 0) then
        pcall(function()
            local m = InsertService:LoadAsset(numId)
            if m then objects = {m} end
        end)
    end
    if not objects or #objects == 0 then
        updateStatus("Gagal load ID: " .. tostring(numId))
        return false
    end

    local before = #State.active
    for _, obj in ipairs(objects) do
        processItem(obj, char, data)
    end
    return #State.active > before
end

local restoreRunning = false
local function restoreAll(char)
    if restoreRunning then return end
    restoreRunning = true

    for _, acc in ipairs(State.active) do
        pcall(function() if acc.model then acc.model:Destroy() end end)
    end
    State.active = {}
    State.selected = 0

    if State.headless then hideHead(char) end

    local backup = {}
    for i, v in ipairs(State.persist) do
        backup[i] = v
    end

    for _, item in ipairs(backup) do
        local success = false
        for attempt = 1, 3 do
            if getChar() ~= char then break end
            success = spawnAccessory(item, char)
            if success then break end
            task.wait(1)
        end
        task.wait(0.15)
    end

    State.selected = #State.active
    updateStatusUI()
    restoreRunning = false
end

local function hookCharacter(char)
    State.currentChar = char

    char.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            if n:find("head") or n:find("torso") then
                task.wait(0.6)
                if getChar() == char and #State.persist > 0 then
                    restoreAll(char)
                end
            end
        end
    end)

    task.spawn(function()
        if not waitForRig(char, 15) then return end
        task.wait(0.4)
        if getChar() ~= char then return end
        restoreAll(char)
    end)
end

task.spawn(function()
    while true do
        local char = getChar()
        if char and char ~= State.currentChar then
            hookCharacter(char)
        end
        task.wait(0.5)
    end
end)

do
    local lastCheck = 0
    RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastCheck < 1 then return end
        lastCheck = now

        if #State.persist == 0 then return end
        local char = getChar()
        if not char then return end

        local broken = (#State.active < #State.persist)
        if not broken then
            for _, acc in ipairs(State.active) do
                if not acc.part or not acc.part.Parent
                    or not acc.weld or not acc.weld.Parent then
                    broken = true
                    break
                end
            end
        end
        if broken and not restoreRunning then
            restoreAll(char)
        end
    end)
end

