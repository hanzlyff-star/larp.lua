track(TargetAccBtn.MouseButton1Click:Connect(function()
    local acc = getSelected()
    if not acc then
        updateStatus("Pilih aksesoris dulu (PREV/NEXT)")
        return
    end
    targetModeIdx = targetModeIdx % #TARGET_MODES + 1
    local mode = TARGET_MODES[targetModeIdx]
    TargetAccBtn.Text = "TARGET PART: " .. mode

    local char = getChar()
    if not char then return end
    acc.forceTarget = (mode ~= "AUTO") and mode or nil

    local newTarget
    if acc.forceTarget then
        newTarget = findPartByRole(char, acc.forceTarget)
    end
    if not newTarget then
        newTarget = findTargetPart(char, acc.model, acc.part, nil)
    end
    if newTarget then
        acc.targetPart = newTarget
        acc.targetName = newTarget.Name
        if mode == "HEAD" then
            acc.topMount = true
            acc.handleAtt = acc.part:FindFirstChildOfClass("Attachment")
            if acc.handleAtt then
                acc.offsetCF = topHeadOffset(newTarget, acc.handleAtt) * acc.userDelta
            end
        else
            acc.topMount = false
            local offset = computeOffset(newTarget, char, { _handle = acc.part })
            if offset then
                acc.offsetCF = offset
            end
        end
    end
    rebuildPersist()
    updateStatusUI()
end))

