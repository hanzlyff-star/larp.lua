local function applyC0Offset(dx, dy, dz)
    local acc = getSelected()
    if acc and acc.weld and acc.weld:IsA("Weld") then
        acc.weld.C0 = acc.weld.C0 * CFrame.new(dx, dy, dz)
        rebuildPersist()
    end
end

local function applyRotation(rx, ry, rz)
    local acc = getSelected()
    if acc and acc.weld and acc.weld:IsA("Weld") then
        acc.weld.C0 = acc.weld.C0 * CFrame.Angles(rx, ry, rz)
        rebuildPersist()
    end
end

