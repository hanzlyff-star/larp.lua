local restoreRunning = false
local lastRestore    = 0
local function restoreAll(char)
    if restoreRunning then return end
    if State.loadingPreset then return end
    if tick() - lastRestore < 1.5 then return end
    restoreRunning = true
    lastRestore = tick()
    for _, acc in ipairs(State.active) do
        pcall(function() if acc.model then acc.model:Destroy() end end)
    end
    State.active = {}
    State.selected = 0
    if State.headless then hideHeadNow(char) end
    local backup = {}
    for i, v in ipairs(State.persist) do
        backup[i] = v
    end
    for _, item in ipairs(backup) do
        local success = false
        for attempt = 1, 3 do
            if not LoopsRunning then break end
            if getChar() ~= char then break end
            success = spawnAccessory(item, char)
            if success then break end
            task.wait(1)
        end
        task.wait(0.15)
    end
    State.selected = #State.active
    updateStatusUI()
    restoreRunning = false
end

local function rebindAccessories(char)
    if #State.active == 0 then return true end
    for _, acc in ipairs(State.active) do
        if not acc.part or not acc.part.Parent then
            return false
        end
    end
    for _, acc in ipairs(State.active) do
        local newTarget
        if acc.forceTarget then
            newTarget = findPartByRole(char, acc.forceTarget)
        end
        if not newTarget then
            if acc.targetName and acc.targetName:lower():find("head") then
                newTarget = findHead(char)
            else
                newTarget = findTorso(char)
            end
        end
        if not newTarget then
            newTarget = findTorso(char) or findHead(char)
        end
        if not newTarget then return false end
        local data
        if acc.topMount then
            data = { topMount = true, userDelta = {acc.userDelta:GetComponents()}, _handle = acc.part }
        else
            data = {
                c0 = acc.offsetCF and {acc.offsetCF:GetComponents()} or nil,
                c1 = acc.c1Comp,
                rootRel = acc.rootRelComp,
                _handle = acc.part,
            }
        end
        local offset = computeOffset(newTarget, char, data)
        if offset then
            acc.targetPart = newTarget
            acc.offsetCF = offset
        else
            return false
        end
    end
    return true
end

local CORE_PART_NAMES = {
    Head = true, Torso = true, UpperTorso = true,
    LowerTorso = true, HumanoidRootPart = true,
}

local function hookCharacter(char)
    State.currentChar = char
    track(char.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") and d.Parent == char and CORE_PART_NAMES[d.Name] then
            task.wait(0.6)
            if not LoopsRunning or State.loadingPreset then return end
            if getChar() ~= char then return end
            if #State.persist == 0 then return end
            if #State.active > 0 then
                if not rebindAccessories(char) then
                    restoreAll(char)
                end
            else
                restoreAll(char)
            end
        end
    end))
    task.spawn(function()
        if not waitForRig(char, 15) then return end
        task.wait(0.3)
        if not LoopsRunning or State.loadingPreset then return end
        if getChar() ~= char then return end
        if #State.persist == 0 then return end
        if #State.active > 0 then
            if not rebindAccessories(char) then
                restoreAll(char)
            end
        else
            restoreAll(char)
        end
    end)
end

task.spawn(function()
    while LoopsRunning do
        local char = getChar()
        if char and char ~= State.currentChar then
            hookCharacter(char)
        end
        task.wait(0.5)
    end
end)

do
    local lastCheck = 0
    track(RunService.Heartbeat:Connect(function()
        if not LoopsRunning then return end
        if State.loadingPreset then return end
        local now = tick()
        if now - lastCheck < 1 then return end
        lastCheck = now
        if #State.persist == 0 then return end
        local char = getChar()
        if not char then return end
        local needRespawn = false
        local needRebind = false
        for _, acc in ipairs(State.active) do
            if not acc.part or not acc.part.Parent then
                needRespawn = true
                break
            end
            if not acc.targetPart or not acc.targetPart.Parent then
                needRebind = true
            end
        end
        if #State.active < #State.persist then
            needRespawn = true
        end
        if needRespawn then
            if not restoreRunning then
                restoreAll(char)
            end
        elseif needRebind then
            if not rebindAccessories(char) then
                restoreAll(char)
            end
        end
    end))
end

